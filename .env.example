APP_NAME=GridRAG
ENVIRONMENT=development
DEBUG=true
AUTH_DISABLED=true
SECRET_KEY=replace-this-secret-key-with-at-least-32-bytes

DATABASE_URL=mysql+asyncmy://gridrag:gridrag@127.0.0.1:3306/gridrag
SYNC_DATABASE_URL=mysql+pymysql://gridrag:gridrag@127.0.0.1:3306/gridrag
DB_AUTO_CREATE=false

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CACHE_TTL_SECONDS=1800

MEMORY_ENABLED=true
MEMORY_AUTO_SAVE=true
MEMORY_MIN_CONTENT_LENGTH=8
MEMORY_MAX_ITEMS=100
MEMORY_RELEVANCE_LIMIT=5

WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=searxng
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5

MCP_ENABLED=true
MCP_PROTOCOL_VERSION=2025-11-25

QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_USE_FP16=false

CHROMA_PERSIST_DIR=storage/chroma
UPLOAD_DIR=storage/uploads
LOG_DIR=logs

VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
